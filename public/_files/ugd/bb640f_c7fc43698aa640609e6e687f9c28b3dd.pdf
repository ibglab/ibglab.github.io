   <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
      <rdf:Description rdf:about=""
            xmlns:dc="http://purl.org/dc/elements/1.1/">
         <dc:format>application/pdf</dc:format>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Motor tics are sudden, brief, repetitive movements that constitute the main symptom of Tourette syndrome (TS).</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Motor tics evoked by striatal disinhibition in the rat</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>Izhar Bar-Gad</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:subject>
            <rdf:Bag>
               <rdf:li>basal ganglia</rdf:li>
               <rdf:li>Tourette syndrome</rdf:li>
               <rdf:li>striatum</rdf:li>
               <rdf:li>bicuculline</rdf:li>
               <rdf:li>GABA</rdf:li>
            </rdf:Bag>
         </dc:subject>
      </rdf:Description>
      <rdf:Description rdf:about=""
            xmlns:pdf="http://ns.adobe.com/pdf/1.3/">
         <pdf:Producer>Acrobat Distiller 8.1.0 (Windows)</pdf:Producer>
         <pdf:Keywords>basal ganglia, Tourette syndrome, striatum, bicuculline, GABA</pdf:Keywords>
      </rdf:Description>

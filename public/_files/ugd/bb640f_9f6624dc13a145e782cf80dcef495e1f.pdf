         <xap:MetadataDate>2014-05-27T13:36:43+05:30</xap:MetadataDate>
      </rdf:Description>
      <rdf:Description rdf:about=""
            xmlns:pdf="http://ns.adobe.com/pdf/1.3/">
         <pdf:Producer>Acrobat Distiller 8.0.0 (Windows)</pdf:Producer>
         <pdf:Keywords>magnetic stimulation, patch-clamp, action potential, cortex</pdf:Keywords>
      </rdf:Description>

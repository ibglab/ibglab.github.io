---
const { course } = Astro.props;
---

<section
  class="course-password-gate"
  data-course-password-gate
  data-access-key={course.key}
  data-password-hash={course.passwordHash}
  aria-labelledby="course-gate-title"
>
  <div class="course-gate-panel">
    <p class="eyebrow">{course.eyebrow ?? "Protected course"}</p>
    <p id="course-gate-title" class="course-gate-title" role="heading" aria-level="1">{course.label}</p>
    <p>{course.prompt ?? "Enter the course password to view these materials."}</p>
    <form class="course-gate-form">
      <label for="course-password">Password</label>
      <div class="course-gate-controls">
        <input
          id="course-password"
          name="password"
          type="password"
          autocomplete="current-password"
          required
        />
        <button type="submit">{course.actionLabel ?? "Open course"}</button>
      </div>
      <p class="course-gate-error" aria-live="polite"></p>
    </form>
  </div>
</section>

<div class="protected-course-content" data-protected-course-content hidden>
  <slot />
</div>

<script>
  const encoder = new TextEncoder();

  function toHex(buffer) {
    return [...new Uint8Array(buffer)]
      .map((byte) => byte.toString(16).padStart(2, "0"))
      .join("");
  }

  for (const gate of document.querySelectorAll("[data-course-password-gate]")) {
    const form = gate.querySelector(".course-gate-form");
    const input = gate.querySelector("input[type='password']");
    const error = gate.querySelector(".course-gate-error");
    const content = gate.nextElementSibling;
    const accessKey = gate.dataset.accessKey;
    const expectedHash = gate.dataset.passwordHash;

    function unlock() {
      gate.remove();
      if (content instanceof HTMLElement) {
        content.hidden = false;
        content.querySelector("h1")?.focus();
      }
    }

    if (accessKey && sessionStorage.getItem(`ibglab-access:${accessKey}`) === "granted") {
      unlock();
      continue;
    }

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      error.textContent = "";

      if (!(input instanceof HTMLInputElement) || !expectedHash || !crypto.subtle) {
        error.textContent = "Password verification is unavailable in this browser.";
        return;
      }

      const digest = await crypto.subtle.digest("SHA-256", encoder.encode(input.value));
      input.value = "";

      if (toHex(digest) !== expectedHash) {
        error.textContent = "Incorrect password.";
        input.focus();
        return;
      }

      if (accessKey) {
        sessionStorage.setItem(`ibglab-access:${accessKey}`, "granted");
      }
      unlock();
    });
  }
</script>

<style>
  .course-password-gate {
    width: min(920px, calc(100% - 2rem));
    min-height: 62vh;
    margin: 0 auto;
    padding: 4rem 0;
    display: grid;
    place-items: start center;
  }

  .course-password-gate[hidden],
  .protected-course-content[hidden] {
    display: none;
  }

  .course-gate-panel {
    width: min(100%, 34rem);
    padding: 1.5rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-top: 4px solid var(--green);
    border-radius: 8px;
  }

  .course-gate-title {
    margin: 0;
    font-size: 3rem;
    font-weight: 800;
    line-height: 1.12;
  }

  .course-gate-form {
    margin-top: 1.5rem;
  }

  .course-gate-form label {
    display: block;
    margin-bottom: 0.4rem;
    font-weight: 700;
  }

  .course-gate-controls {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.65rem;
  }

  .course-gate-controls input,
  .course-gate-controls button {
    min-height: 2.75rem;
    border-radius: 6px;
    font: inherit;
  }

  .course-gate-controls input {
    min-width: 0;
    padding: 0.55rem 0.7rem;
    border: 1px solid var(--line);
  }

  .course-gate-controls input:focus {
    outline: 3px solid color-mix(in srgb, var(--blue) 25%, transparent);
    border-color: var(--blue);
  }

  .course-gate-controls button {
    padding: 0.55rem 1rem;
    border: 1px solid var(--ink);
    background: var(--ink);
    color: #fff;
    cursor: pointer;
  }

  .course-gate-error {
    min-height: 1.5rem;
    margin: 0.65rem 0 0;
    color: #9c2f24;
    font-weight: 700;
  }

  @media (max-width: 520px) {
    .course-password-gate {
      width: min(100% - 1.25rem, 920px);
      padding-top: 2rem;
    }

    .course-gate-controls {
      grid-template-columns: 1fr;
    }

    .course-gate-title {
      font-size: 2.35rem;
    }
  }
</style>

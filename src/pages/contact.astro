---
import BaseLayout from "../layouts/BaseLayout.astro";

const email = "izhar.bar-gad@biu.ac.il";
const address = [
  "The Leslie and Susan Gonda Brain Research Center",
  "Building 901, rooms: 407 (lab), 408 (office), 418 (students)",
  "Bar-Ilan University",
  "Ramat-Gan, 5290002",
  "Israel",
];
const mapQuery = encodeURIComponent(address.join(", "));
---

<BaseLayout title="Contact | IBG Lab" description="Contact IBG Lab at Bar-Ilan University.">
  <article class="content-page contact-page">
    <header class="page-head contact-head">
      <h1>Contact</h1>
    </header>

    <div class="contact-layout">
      <section class="contact-form-panel" aria-labelledby="contact-form-title">
        <h2 id="contact-form-title">Get in touch!</h2>
        <form class="contact-form" action={`mailto:${email}`} method="post" enctype="text/plain" data-recipient={email}>
          <label>
            <span>Name *</span>
            <input name="name" type="text" autocomplete="name" required maxlength="100" />
          </label>
          <label>
            <span>Email *</span>
            <input name="email" type="email" autocomplete="email" required maxlength="100" />
          </label>
          <label>
            <span>Subject</span>
            <input name="subject" type="text" maxlength="250" />
          </label>
          <label>
            <span>Message</span>
            <textarea name="message" rows="6"></textarea>
          </label>
          <button type="submit">Send</button>
          <p class="form-status" aria-live="polite"></p>
        </form>
      </section>

      <section class="contact-details" aria-labelledby="address-title">
        <h2 id="address-title">Address</h2>
        <address>
          {address.map((line) => <span>{line}</span>)}
        </address>

        <dl>
          <div>
            <dt>Tel</dt>
            <dd><a href="tel:+97235317141">+972-3-5317141</a></dd>
          </div>
          <div>
            <dt>Fax</dt>
            <dd>+972-3-5352184</dd>
          </div>
          <div>
            <dt>Email</dt>
            <dd><a href={`mailto:${email}`}>{email}</a></dd>
          </div>
        </dl>

        <iframe
          class="contact-map"
          title="Google map to IBG Lab"
          src={`https://maps.google.com/maps?q=${mapQuery}&output=embed`}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </section>
    </div>
  </article>
</BaseLayout>

<script>
  const form = document.querySelector(".contact-form");
  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    const data = new FormData(form);
    const recipient = form.dataset.recipient;
    const name = String(data.get("name") || "").trim();
    const email = String(data.get("email") || "").trim();
    const subject = String(data.get("subject") || "IBG Lab contact").trim() || "IBG Lab contact";
    const message = String(data.get("message") || "").trim();
    const body = [
      `Name: ${name}`,
      `Email: ${email}`,
      "",
      message,
    ].join("\n");
    const status = form.querySelector(".form-status");

    if (status) status.textContent = "Opening your email app...";
    window.location.href = `mailto:${recipient}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
  });
</script>

<style>
  .contact-page {
    width: min(var(--max), calc(100% - 2rem));
  }

  .contact-head h1 {
    max-width: 100%;
  }

  .contact-layout {
    display: grid;
    grid-template-columns: minmax(280px, 0.9fr) minmax(320px, 1.1fr);
    gap: 2rem;
    align-items: start;
  }

  .contact-form-panel,
  .contact-details {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 1.25rem;
  }

  .contact-form-panel h2,
  .contact-details h2 {
    margin-top: 0;
  }

  .contact-form {
    display: grid;
    gap: 0.9rem;
  }

  .contact-form label {
    display: grid;
    gap: 0.35rem;
    color: var(--muted);
    font-size: 0.92rem;
  }

  .contact-form input,
  .contact-form textarea {
    width: 100%;
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 0.75rem 0.85rem;
    background: #fff;
    color: var(--ink);
    font: inherit;
  }

  .contact-form input:focus,
  .contact-form textarea:focus {
    outline: 2px solid var(--blue);
    outline-offset: 2px;
  }

  .contact-form button {
    justify-self: start;
    min-width: 7rem;
    border: 1px solid var(--ink);
    border-radius: 8px;
    padding: 0.72rem 1.2rem;
    background: var(--ink);
    color: #fff;
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }

  .contact-form button:hover {
    background: var(--green);
    border-color: var(--green);
  }

  .form-status {
    min-height: 1.4rem;
    margin: 0;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .contact-details address {
    display: grid;
    gap: 0.25rem;
    color: var(--ink);
    font-style: normal;
  }

  .contact-details dl {
    display: grid;
    gap: 0.7rem;
    margin: 1.5rem 0;
  }

  .contact-details div {
    display: grid;
    gap: 0.15rem;
  }

  .contact-details dt {
    color: var(--muted);
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .contact-details dd {
    margin: 0;
  }

  .contact-map {
    width: 100%;
    min-height: 22rem;
    border: 1px solid var(--line);
    border-radius: 8px;
  }

  @media (max-width: 820px) {
    .contact-page {
      width: min(100% - 1.25rem, var(--max));
    }

    .contact-layout {
      grid-template-columns: 1fr;
    }
  }
</style>

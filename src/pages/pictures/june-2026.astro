---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageRenderer from "../../components/PageRenderer.astro";

const page = {
  title: "June 2026",
  description: "IBG Lab pictures from June 2026.",
  targetPath: "/pictures/june-2026/",
  section: "Gallery",
  isBlog: false,
  blocks: [],
  links: [],
  images: [
    {
      localPath: "/media/june-2026-locopd-poster.jpeg",
      alt: "Two IBG Lab researchers presenting the LoCoPD Parkinson's disease poster",
      caption: "LoCoPD poster presentation",
      width: 1204,
      height: 1600,
    },
    {
      localPath: "/media/june-2026-nabupd-poster.jpeg",
      alt: "Two IBG Lab researchers standing beside the NabuPD Parkinson's disease poster",
      caption: "NabuPD poster presentation",
      width: 1204,
      height: 1600,
    },
    {
      localPath: "/media/june-2026-lab-group.jpeg",
      alt: "Eight IBG Lab members posing together during a group activity",
      caption: "IBG Lab group activity",
      width: 2040,
      height: 1536,
    },
    {
      localPath: "/media/june-2026-lab-group-activities.jpeg",
      alt: "Eight IBG Lab members holding objects during a group activity",
      caption: "IBG Lab group activity",
      width: 1536,
      height: 2040,
    },
  ],
};
---

<BaseLayout title="June 2026 | Pictures | IBG Lab" description={page.description}>
  <PageRenderer page={page} />
</BaseLayout>

---
import BaseLayout from "../layouts/BaseLayout.astro";
import pages from "../content/pages.json";

const page = pages.find((entry) => entry.targetPath === "/") ?? {
  title: "IBG Lab",
  description: "Migrated local site content will appear here after running npm run extract.",
  blocks: [
    {
      kind: "paragraph",
      text: "Run npm run extract to crawl the Wix site and populate the local editable content.",
    },
  ],
  images: [],
  links: [],
};
const descriptionParagraphs = page.blocks
  .filter((block) => block.kind === "paragraph")
  .slice(0, 4);
---

<BaseLayout title={page.title} description={page.description}>
  <article class="content-page home-page">
    <div class="page-body">
      {descriptionParagraphs.map((block) => <p>{block.text}</p>)}
    </div>
    <p class="news-link"><a href="/news/">In the media</a></p>
  </article>
</BaseLayout>

<style>
  .home-page {
    padding-top: 3.5rem;
  }

  .home-page .page-body p {
    text-align: justify;
    text-align-last: left;
    text-justify: inter-word;
  }

  .news-link {
    margin: 2rem 0 0;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
    max-width: 760px;
    font-weight: 700;
  }
</style>
